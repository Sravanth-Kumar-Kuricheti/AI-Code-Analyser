# ==========================================
# RepoPilot-AI Environment Configuration
# ==========================================

# LLM Providers (Groq recommended for high-speed inference)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
FALLBACK_TO_MOCK_LLM=true

# Database (defaults to local SQLite if POSTGRES_URL is empty)
DATABASE_URL=sqlite:///./repopilot.db
# POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/repopilot

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_IN_MEMORY=true

# GitHub Integration (Optional: for higher rate limits on public repos)
GITHUB_TOKEN=your_github_personal_access_token_here

# Redis & Celery (Optional: will use synchronous execution if Redis is unavailable)
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false

# App Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_API_URL=http://127.0.0.1:8000
REPO_STORAGE_PATH=./data/repos
MAX_FILE_SIZE_KB=500
EMBEDDING_MODEL=all-MiniLM-L6-v2
